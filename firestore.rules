rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == "mongcoaching@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    function publicPost() {
      return resource.data.isPublished == true
        && (
          !("publishAt" in resource.data)
          || resource.data.publishAt == null
          || resource.data.publishAt <= request.time
        );
    }

    function hasCourseAccess(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId))
        && get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data.courseId == courseId
        && get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data.status == "active"
        && (
          !("expiresAt" in get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data)
          || get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data.expiresAt == null
          || get(/databases/$(database)/documents/course_access/$(request.auth.uid + "_" + courseId)).data.expiresAt > request.time
        );
    }

    match /users/{userId} {
      allow get: if owns(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          "activeSessions",
          "createdAt",
          "displayName",
          "email",
          "photoURL",
          "role",
          "uid",
          "updatedAt"
        ])
        && request.resource.data.role == "student"
        && request.resource.data.email == request.auth.token.email
        && (
          !("uid" in request.resource.data)
          || request.resource.data.uid == userId
        );
      allow update: if isAdmin()
        || (
          owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "activeSessions",
            "displayName",
            "email",
            "photoURL",
            "uid",
            "updatedAt"
          ])
          && request.resource.data.email == request.auth.token.email
          && (
            !("uid" in request.resource.data)
            || request.resource.data.uid == userId
          )
          && (
            !("activeSessions" in request.resource.data)
            || request.resource.data.activeSessions.size() <= 3
          )
        );
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAdmin() || publicPost();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && !("courseResources" in request.resource.data)
        && !("students" in request.resource.data)
        && !("videoId" in request.resource.data)
        && !("videoUrl" in request.resource.data)
        && !("videoURL" in request.resource.data);
      allow delete: if isAdmin();
    }

    match /course_content/{courseId} {
      allow read: if isAdmin() || hasCourseAccess(courseId);
      allow write: if isAdmin();
    }

    match /course_access/{accessId} {
      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        "banners",
        "categories",
        "coupons",
        "hero_images",
        "homepage_content",
        "instructors",
        "jobs"
      ];
      allow write: if collectionName in [
        "banners",
        "categories",
        "coupons",
        "hero_images",
        "homepage_content",
        "instructors",
        "jobs"
      ] && isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.userEmail == request.auth.token.email
          )
        );
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
      allow create: if false;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "cancelReason",
            "cancelledAt",
            "status",
            "updatedAt"
          ])
        );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "comment",
          "courseId",
          "createdAt",
          "rating",
          "userAvatar",
          "userId",
          "userName"
        ])
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 2
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "createdAt",
          "lessonId",
          "text",
          "userAvatar",
          "userId",
          "userName"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /post_feedback/{feedbackId} {
      allow read: if isAdmin() || resource.data.isApproved == true;
      allow write: if isAdmin();
    }

    match /storage_files/{fileId} {
      allow get: if isAdmin()
        || (
          resource.data.isPublic == true
          && (
            !("isDeleted" in resource.data)
            || resource.data.isDeleted != true
          )
        );
      allow list, write: if isAdmin();
    }

    match /storage_folders/{folderId} {
      allow read, write: if isAdmin();
    }

    match /{privateCollection}/{documentId} {
      allow read, write: if privateCollection in [
        "bank_transactions",
        "leads",
        "newsletter_subscribers",
        "post_view_events",
        "referral_partners",
        "system_settings"
      ] && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
