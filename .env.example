# Public browser configuration (safe to expose)
## Set to luathapdan.vn only after Google OAuth allows
## https://luathapdan.vn/__/auth/handler and Pages proxies /__/auth/*.
VITE_GOOGLE_AUTH_DOMAIN=
VITE_S3_ENDPOINT=https://s3.example.com
VITE_S3_REGION=region-name
VITE_S3_BUCKET=public-bucket-name

# Build-only Firebase Admin credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-server-secret
# Firebase Web API key là định danh công khai dùng cho kiểm tra route động ở edge.
FIREBASE_WEB_API_KEY=replace-with-public-web-api-key
# Server-only Bunny Storage settings for local Pages Function development.
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_ACCESS_KEY=replace-with-storage-zone-password
BUNNY_PULL_ZONE_HOSTNAME=https://your-pull-zone.b-cdn.net
# Optional for region-specific zones, e.g. sg.storage.bunnycdn.com
BUNNY_STORAGE_API_HOSTNAME=storage.bunnycdn.com
# Chỉ bật cho build thử nghiệm khi chủ động chấp nhận sitemap không có nội dung động.
ALLOW_STATIC_SITEMAP=false
