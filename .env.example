# Public browser configuration (safe to expose)
VITE_S3_ENDPOINT=https://s3.example.com
VITE_S3_REGION=region-name
VITE_S3_BUCKET=public-bucket-name

# Server-only upload credentials (never prefix secrets with VITE_)
S3_ENDPOINT=https://s3.example.com
S3_REGION=region-name
S3_BUCKET=public-bucket-name
S3_ACCESS_KEY=replace-with-server-secret
S3_SECRET_KEY=replace-with-server-secret
S3_MAX_UPLOAD_BYTES=21474836480

# Dedicated server secrets.
# In production, store these with `firebase functions:secrets:set SECRET_NAME`.
STORAGE_MEDIA_TOKEN_SECRET=replace-with-at-least-32-random-bytes
META_CAPI_ACCESS_TOKEN=replace-with-server-secret
META_PIXEL_ID=1526874981588150
CRM_DATABASE_URL=https://project-default-rtdb.region.firebasedatabase.app

# Build-only Firebase Admin credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-server-secret
